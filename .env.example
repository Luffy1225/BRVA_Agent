# ==========================================================
# BRVA_Agent Environment Configuration
# ==========================================================

# 1. LLM API Key (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. BRVA Backend Production / Local API Settings
BRVA_API_BASE_URL=https://api.eva-virtual.com
BRVA_AGENT_API_KEY=brva_sk_live_your_agent_key_here

# 3. Execution & Safety Configuration
BACKEND_TIMEOUT_SECONDS=5.0
FALLBACK_TO_LOCAL=true
