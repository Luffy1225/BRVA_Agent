# ==========================================================
# BRVA_Agent Environment Configuration
# ==========================================================

# 1. LLM Provider Selector ('auto' | 'ollama' | 'gemini' | 'offline')
# 'auto': Prioritizes LAN/Local Ollama -> Google Gemini -> Offline Rule Engine
LLM_PROVIDER=auto

# 2. Local / LAN Ollama LLM Configuration (支援區網內 Ollama 主機)
# 例如區網伺服器：http://192.168.1.100:11434 或本機 http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT_SECONDS=30.0

# 3. Google Gemini API (Cloud)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# 4. BRVA Backend Production / Local API Settings
BRVA_API_BASE_URL=https://api.eva-virtual.com
OFFICIAL_TEST_TOKEN=

# 5. Execution & Safety Configuration
BACKEND_TIMEOUT_SECONDS=5.0
FALLBACK_TO_LOCAL=true
